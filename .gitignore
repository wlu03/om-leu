# Documentation (kept local)
docs/

# Per-dataset directories: <name>/data (raw + prepared), <name>/results
# (run outputs), <name>/cache (outcomes / embeddings sqlite). Only the
# Amazon field description is versioned.
*/data/*
*/results/*
*/cache/*
!amazon/data/fields.csv

# Tooling state
.pytest_cache/
.mypy_cache/
.ruff_cache/
tmp/
.claude/
runs/
experiments/data/

# ablation/: per-run JSON results are tracked (per-event NLL, needed for the paired intervals)

# paper source is tracked; build products are not
!paper/
!paper/**
paper/main.pdf
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.out

# experiment package byte-code
omleu_experiments/**/__pycache__/
